{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@blockverse/shared": ["../shared/index.ts"],
      "@blockverse/shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
